{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Casa em Dia",
  "version": "1.0.0",
  "identifier": "io.github.formigacamuflada.casaemdia",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Casa em Dia",
        "width": 1320,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://*.pluggy.ai; frame-src https://*.pluggy.ai; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Casa em Dia",
    "shortDescription": "Finanças do casal",
    "longDescription": "Contas da casa, divisão 50/50, cartões, moradia, investimentos e metas do casal.",
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"], "displayLanguageSelector": false },
      "wix": { "language": "pt-BR" }
    }
  }
}
